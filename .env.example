# ============================================================
# Recovery Companion — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Supabase (for auth, database, and real-time features)
# Get these from: https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI API (for AI journaling and reflection)
# Get your key from: https://platform.openai.com/api-keys
# Also works with any OpenAI-compatible API (Together, Groq, local LLM, etc.)
# To use a different provider, set the baseURL in src/services/ai.ts
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-api-key

# RevenueCat (in-app purchases / subscriptions)
# Get the public SDK keys from: https://app.revenuecat.com -> Project -> API keys.
# Use the platform-specific PUBLIC keys (they start with "appl_" / "goog_").
# Leave blank during early development — the app runs as Free with the store
# disabled, and shows indicative pricing on the paywall.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
